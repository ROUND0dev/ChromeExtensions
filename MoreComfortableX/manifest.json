{
  "manifest_version": 3,
  "name": "MoreComfortableX(JP)",
  "version": "1.0.1",
  "description": "おすすめポストのタブを削除し、自分のフォローユーザーのポストのみをタイムラインで閲覧するように変更します。またオプションでリストIDを設定する事でプレミアムボタンから指定したリストにすぐ移動できるように変更します。",
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "permissions": [
    "storage"
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
}
}